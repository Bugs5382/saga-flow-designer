{
  "name": "@bugs5382/saga-flow-designer",
  "version": "0.0.0",
  "description": "React components and utilities for visualising and editing saga-orchestration workflows and runs.",
  "license": "Apache-2.0",
  "author": "Bugs5382",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.js",
      "require": "./dist/tailwind.preset.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugs5382/saga-flow-designer.git"
  },
  "homepage": "https://github.com/Bugs5382/saga-flow-designer#readme",
  "bugs": {
    "url": "https://github.com/Bugs5382/saga-flow-designer/issues"
  },
  "keywords": [
    "react",
    "workflow",
    "saga",
    "flow",
    "react-flow"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "docs": "typedoc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "demo": "vite --config examples/vite.config.ts",
    "build-demo": "vite build --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@the-rabbit-hole/eslint-config": "^0.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
